# ==========================================================================
# Scheme Monitor — backend environment template
#
#   cp .env.example .env      then fill in real values
#
# Every variable below is one the code ACTUALLY reads. Verified against
# `grep -rhoE "process\.env\.[A-Z_0-9]+" src/`.
#
# NEVER commit .env. It is listed in .gitignore.
# ==========================================================================

# ---- Database (REQUIRED) --------------------------------------------------
# Note the name: MONGODB_URI (not MONGO_URI).
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/scheme_monitor

# ---- Server ---------------------------------------------------------------
PORT=4000
LOG_LEVEL=info
# Comma-separated origins allowed to call the API. No wildcard in production.
FRONTEND_ORIGIN=http://localhost:5173
# Global API rate limit, per IP per 15 minutes.
RATE_LIMIT_MAX=300
# The collection trigger is far tighter: one run crawls thousands of schemes
# and spends LLM quota, so it is 2/hour by default.
COLLECT_RATE_LIMIT_MAX=2

# ---- Auth (REQUIRED once auth is enabled) ---------------------------------
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Bootstrap admin. Created on first boot ONLY if no ADMIN user exists yet.
# Both must be set; the password must be at least 8 characters.
#
# If ADMIN_EMAIL names an account that ALREADY exists as a normal user, the
# server logs a warning and creates nothing. Promotion by environment variable
# would let anyone who can edit this file take over an existing person's
# account, so a role change has to be a deliberate action instead.
#
# Without an admin, POST /api/collect/run and the frontend Admin page are
# unreachable. `npm run collect:once` does the same collection from the CLI.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- Scheduler ------------------------------------------------------------
# 5-field cron. Default here is every 6 hours; do not hammer the source API.
CRON_SCHEDULE=0 */6 * * *
# Run one collection cycle immediately on boot (dev convenience).
RUN_ON_STARTUP=false

# ---- myScheme collector ---------------------------------------------------
# Public key from the myScheme frontend bundle. Re-extract from DevTools ->
# Network -> any api.myscheme.gov.in request -> Headers -> x-api-key.
MYSCHEME_API_KEY=
# Dev cap on how many schemes to pull per run. Leave UNSET in production.
MYSCHEME_LIMIT=50

# ==========================================================================
# LLM provider — pick ONE via LLM_PROVIDER.
#
#   groq    Free tier ~14,400 req/day. RECOMMENDED. https://console.groq.com
#   gemini  Small free tier (~50/day). Not viable for a full backfill.
#   ollama  Local, unlimited, offline. Requires `ollama serve`.
# ==========================================================================
# Hard ceiling on a single provider call, in ms. A provider that accepts the
# connection then stalls used to block the caller forever — and the callers are
# the scheduled collection cycle and every chat request. On timeout the call
# fails and the caller takes its normal rules-only path.
LLM_TIMEOUT_MS=30000

LLM_PROVIDER=groq

# ---- Groq -----------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VERIFIER_MODEL=openai/gpt-oss-120b

# ---- Gemini ---------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VERIFIER_MODEL=gemini-2.5-flash

# ---- Ollama ---------------------------------------------------------------
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
OLLAMA_VERIFIER_MODEL=llama3.1

# ---- LLM behaviour --------------------------------------------------------
# Enable LLM assistance during eligibility extraction.
LLM_EXTRACT_ELIGIBILITY=true
# Enable the second-stage LLM verifier on /matches.
SCHEME_VERIFIER_ENABLED=true
# Sleep between LLM calls (ms). 0 for Groq/Ollama; raise for Gemini free tier.
LLM_CALL_DELAY_MS=0
# LLM is an EXCEPTION HANDLER: only escalate when the deterministic extractor
# is below this confidence. 0.7 skips the LLM on ~70% of schemes.
# Set 1.1 to force the LLM on everything; 0 to disable escalation entirely.
LLM_ESCALATE_BELOW=0.7

# ---- Recommendations ------------------------------------------------------
# Default number of recommendations returned by /matches (?limit overrides).
DEFAULT_MATCH_LIMIT=20

# ---- Backfill script ------------------------------------------------------
BATCH_SIZE=100
# Cap LLM extractions in a single backfill run (protects quota). Unset = no cap.
SCHEMES_TO_EXTRACT=

# ---- Email (optional; leave blank to disable sending) ---------------------
# Gmail: use an App Password, not your account password.
# Note the name: SMTP_APP_PASSWORD (not SMTP_PASS).
SMTP_USER=
SMTP_APP_PASSWORD=

# ---- Phase J / K0 ----
# How many recommendations count as "the user's list" for propagation.
# A scheme outside this cutoff is eligible but not recommended.
RECOMMENDATION_TOP_K=10

# The pre-Phase-I notifier: scans every user and emails on eligibility rather
# than on policy impact. OFF by default. Phase L replaces it with a
# Notification Agent driven by actual recommendation transitions; the two must
# never both be on, or one change produces two emails.
LEGACY_NOTIFIER=false

# Let the Policy Change Agent escalate genuinely ambiguous PROSE changes to
# the LLM. Structured field changes are always classified deterministically —
# the LLM never sees them and never decides a direction.
POLICY_CHANGE_LLM=true

# ---- Phase K ----
# Grounded explanations attached to each RecommendationHistory row.
# Set to false to skip generation entirely; the audit row is written either way.
EXPLANATIONS=true
# Allow the Explanation Agent to synthesise multi-condition changes with the
# LLM. Single threshold changes are always rendered deterministically. Any
# generated sentence is rejected if it contains a figure the record does not
# support, so an outage costs fluency, never accuracy.
EXPLANATION_LLM=true

# ---- Phase L: policy-aware notifications ----
# The Notification Agent, driven by the transitions Recommendation Propagation
# recorded. Set to false to skip delivery entirely; the audit trail is written
# either way. This is the replacement for LEGACY_NOTIFIER — never enable both.
NOTIFICATIONS=true
# Email retry: attempts before a row is marked FAILED, and the base for the
# exponential backoff between them (1, 2, 4, 8 minutes at the default).
NOTIFICATION_MAX_RETRIES=4
NOTIFICATION_BACKOFF_MS=60000

# ---- Phase L: delivery mode and the retry sweep ----
# inline  — send during the collection cycle (default; simple, correct at
#           current scale)
# queued  — persist the row and return; the scheduled sweep delivers it, so
#           policy processing never waits on SMTP
NOTIFICATION_DELIVERY_MODE=inline
# The sweep runs inside the EXISTING scheduler as a second job. It calls the
# delivery step only and never re-runs a policy agent.
NOTIFICATION_RETRY_CRON=*/5 * * * *
NOTIFICATION_SWEEP_LIMIT=100

# ==========================================================================
# Phase M — version-aware RAG knowledge base
# ==========================================================================

# Master switch for the indexing stage and its scheduled sweep. When false,
# the policy stages, the audit trail and the notifications are all still
# exactly correct — the knowledge base is simply not refreshed.
RAG_INDEXING=true

# ---- Embedding provider ---------------------------------------------------
#   gemini      text-embedding-004, 768 dims. Free tier, already a dependency.
#   ollama      nomic-embed-text, 768 dims. Local, no quota, no egress.
#   local-hash  NOT SEMANTIC. Hashed word tokens projected into 256 dims.
#               Captures LEXICAL overlap only: two texts sharing words score
#               highly, two texts meaning the same thing in different words
#               score near zero.
#
# local-hash is the DEFAULT so the pipeline runs and tests deterministically
# with no network and no API key. Every structural property (versioning,
# invalidation, filtering, metadata) is provider-independent and is verified
# under it. NO RETRIEVAL-QUALITY CLAIM MAY BE MADE FROM local-hash — anything
# measured under it measures the plumbing, not the semantics. Switch to gemini
# or ollama before any evaluation run.
EMBEDDING_PROVIDER=local-hash
GEMINI_EMBEDDING_MODEL=text-embedding-004
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_URL=http://127.0.0.1:11434

# ---- Vector search --------------------------------------------------------
#   scan   fetch by metadata and score cosine similarity in Node. Correct and
#          obvious; O(chunks). Fine for a few thousand chunks.
#   atlas  MongoDB Atlas $vectorSearch. Preferred at scale — the project
#          already runs on Atlas, so it adds no second datastore.
#
# Default is "scan" DELIBERATELY: Atlas $vectorSearch support on this cluster
# has NOT been verified, and shipping an unexecuted code path as the
# recommended one would be dishonest. Switching is this one variable.
#
# Before setting atlas: create a vector index named below on the schemechunks
# collection, over `embedding`, with the dimension your provider emits
# (768 for gemini/ollama), and filter fields status, language, schemeId.
VECTOR_SEARCH_STRATEGY=scan
ATLAS_VECTOR_INDEX=scheme_chunk_vector_index

# ---- Retrieval ------------------------------------------------------------
RAG_TOP_K=6
# Below this cosine score a chunk is treated as unrelated rather than "the
# best of a bad set". Without a floor, retrieval answers every question with
# its least-irrelevant chunk. Tune per embedding provider — a value chosen
# under local-hash does not carry over to a semantic model.
RAG_MIN_SCORE=0.25

# ---- The policy retry sweep (Phase S) -------------------------------------
# A FOURTH job inside the EXISTING scheduler. Re-runs the policy stages for
# changes whose analysis failed transiently — rows carrying
# `policyRetryable: true`. It recollects nothing: the diffs and the version
# snapshot are already stored, so no government source is contacted.
#
# WITHOUT THIS the retry existed only as `npm run policy:retry`, a command a
# human had to remember. A failed policy stage therefore left affected users
# holding a recommendation the change had already invalidated, with no bound on
# how long. `npm run evaluate:staleness` reports that bound and exits non-zero
# if any stage loses its recovery path.
#
# Hourly: more urgent than the RAG sweep (a stale recommendation can withhold a
# benefit) and less urgent than notification delivery (the analysis must be
# re-run, not a stored message re-sent).
POLICY_RETRY_CRON=0 * * * *
POLICY_RETRY_LIMIT=50

# ---- The re-index sweep ---------------------------------------------------
# A THIRD job inside the EXISTING scheduler. Re-embeds schemes whose current
# version has no ACTIVE chunks — what an embedding outage leaves behind.
# Contacts no government source and re-runs no policy agent.
# Hourly, not every 5 minutes: a stale index degrades answer freshness, it
# does not withhold a benefit from anyone.
RAG_REINDEX_CRON=0 * * * *
RAG_SWEEP_LIMIT=25

# ==========================================================================
# Phase N — conversational agent
# ==========================================================================

# Set to false to answer entirely from deterministic templates. Eligibility
# verdicts are identical either way — the LLM only ever phrases them.
CHAT_LLM=true
# Per-authenticated-user, per 15 minutes. Tighter than the global 300 because
# each call can trigger an embedding request and a generation.
CHAT_RATE_LIMIT_MAX=60

# ==========================================================================
# Phase Q — propagation soundness evaluation
# ==========================================================================
#
# Phase Q introduces NO new environment variable. It is listed here so that a
# reader diffing this file against the phase reports does not go looking for
# one.
#
# The offline experiment needs nothing configured:
#
#     npm run evaluate:propagation
#
# It holds its own synthetic population in process and evaluates the Impact
# Agent's candidate filters without a database.
#
# The live experiment reuses MONGODB_URI above and nothing else:
#
#     npm run evaluate:propagation:live
#
# WARNING: the live run WRITES TO THAT DATABASE. It inserts users whose _id
# begins with `q-user-`, runs the corpus through Mongoose, and deletes exactly
# those users afterwards. It touches no other document. Point it at a
# development database, never at production.

# ==========================================================================
# Diagnostics — not needed to run the application
# ==========================================================================

# Restore log output during a test run. The logger is silenced under
# NODE_ENV=test so a failing assertion is not buried in expected warnings.
#   TEST_LOGS=1 npx jest tests/notificationAgent.test.js
TEST_LOGS=

# Used only by scripts/reproModelBoundary.js, which simulates mongoose's
# buffering behaviour to prove no test reaches a real Mongoose model. Mirrors
# mongoose's own bufferTimeoutMS default of 10000.
STUB_BUFFER_TIMEOUT_MS=
